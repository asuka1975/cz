// TEST: Generic identity function
// EXPECT: success
// DESCRIPTION: ジェネリック関数が複数の型で正しく動作することを検証する
// EXPECTED_EXIT_CODE: 0
// EXPECTED_STDOUT: 42\n100\ntrue\n

fn identity<T>(x: T) -> T {
    x
}

fn main() -> i32 {
    // 型推論
    print_i32(identity(42));
    // 明示的型引数
    print_i64(identity<i64>(100i64));
    print_bool(identity(true));
    0
}
